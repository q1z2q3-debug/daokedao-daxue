  "章数": 11,
  "chapters": [
    {"id": "J01", "章号": "经一章", "章题": "大学之道", "所释": "三纲领 · 八条目 · 本末", "首句": "大学之道，在明明德", "原文数": 205, "file": "book/J01-经一章.md", "page": "ch/j01.html", "fig": "fig/j01.svg", "gist": "一条从「知所止」到「天下平」的单向可倒查之路；修身为承重，不为排序。"},
    {"id": "Z01", "章号": "传一章", "章题": "释明明德", "所释": "明明德", "首句": "康诰曰：克明德", "原文数": 26, "file": "book/Z01-释明明德.md", "page": "ch/z01.html", "fig": "fig/z01.svg", "gist": "三书三证，只落一个「自」字：明德本有，工夫在「常目在之」。"},
    {"id": "Z02", "章号": "传二章", "章题": "释新民", "所释": "新民", "首句": "汤之盘铭曰：苟日新", "原文数": 40, "file": "book/Z02-释新民.md", "page": "ch/z02.html", "fig": "fig/z02.svg", "gist": "新不是换掉旧的，是日日不停地洗；自新与新民是一件事的两头。"},
    {"id": "Z03", "章号": "传三章", "章题": "释止于至善", "所释": "止于至善", "首句": "诗云：邦畿千里，惟民所止", "原文数": 203, "file": "book/Z03-释止于至善.md", "page": "ch/z03.html", "fig": "fig/z03.svg", "gist": "止是知其所止：君仁、臣敬、子孝、父慈、交信；切磋琢磨是把「止」磨到精处。"},
    {"id": "Z04", "章号": "传四章", "章题": "释本末", "所释": "本末", "首句": "子曰：听讼，吾犹人也", "原文数": 30, "file": "book/Z04-释本末.md", "page": "ch/z04.html", "fig": "fig/z04.svg", "gist": "使无讼，不在断案在断案之外；明德既明，民志自畏——此谓知本。"},
    {"id": "Z05", "章号": "传五章", "章题": "释格物致知", "所释": "格物致知（朱子补传）", "首句": "此谓知本，此谓知之至也", "原文数": 144, "file": "book/Z05-释格物致知.md", "page": "ch/z05.html", "fig": "fig/z05.svg", "gist": "朱子补传·古本无此章：即物穷理，用力之久而一旦豁然贯通。"},
    {"id": "Z06", "章号": "传六章", "章题": "释诚意", "所释": "诚意", "首句": "所谓诚其意者：毋自欺也", "原文数": 118, "file": "book/Z06-释诚意.md", "page": "ch/z06.html", "fig": "fig/z06.svg", "gist": "诚意是自修之首：毋自欺、慎其独；十目所视，其严乎。"},
    {"id": "Z07", "章号": "传七章", "章题": "释正心修身", "所释": "正心", "首句": "所谓修身在正其心者", "原文数": 72, "file": "book/Z07-释正心修身.md", "page": "ch/z07.html", "fig": "fig/z07.svg", "gist": "忿懥、恐惧、好乐、忧患四者一有，则心不得其正；心不在焉，视听食皆废。"},
    {"id": "Z08", "章号": "传八章", "章题": "释修身齐家", "所释": "齐家", "首句": "所谓齐其家在修其身者", "原文数": 96, "file": "book/Z08-释修身齐家.md", "page": "ch/z08.html", "fig": "fig/z08.svg", "gist": "五辟皆偏：亲爱、贱恶、畏敬、哀矜、敖惰；莫知其子之恶，是偏之最。"},
    {"id": "Z09", "章号": "传九章", "章题": "释齐家治国", "所释": "治国", "首句": "所谓治国必先齐其家者", "原文数": 271, "file": "book/Z09-释齐家治国.md", "page": "ch/z09.html", "fig": "fig/z09.svg", "gist": "不出家而成教于国：孝弟慈三事可推；有诸己而后求诸人，是恕的政。"},
    {"id": "Z10", "章号": "传十章", "章题": "释治国平天下", "所释": "平天下", "首句": "所谓平天下在治其国者", "原文数": 681, "file": "book/Z10-释治国平天下.md", "page": "ch/z10.html", "fig": "fig/z10.svg", "gist": "絜矩之道：六方度人；德本财末，义利之辨；平天下不是压平，是均齐方正。"}
  ]
}
